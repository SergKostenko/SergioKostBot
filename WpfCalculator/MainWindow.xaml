<Window x:Class="WpfCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="440" Width="320" ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="MinHeight" Value="56"/>
            </Style>
        </Grid.Resources>

        <TextBox x:Name="DisplayTextBox" Grid.Row="0" Margin="0,0,0,10"
                 FontSize="36" TextAlignment="Right" IsReadOnly="True"
                 VerticalContentAlignment="Center" Text="0"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Row 0 -->
            <Button Grid.Row="0" Grid.Column="0" Content="C" Click="Clear_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="±" Click="Sign_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="⌫" Click="Backspace_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷" Click="Operator_Click"/>

            <!-- Row 1 -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Digit_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Digit_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Digit_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×" Click="Operator_Click"/>

            <!-- Row 2 -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Digit_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Digit_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Digit_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="−" Click="Operator_Click"/>

            <!-- Row 3 -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Digit_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Digit_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Click="Digit_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Click="Operator_Click"/>

            <!-- Row 4 -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Click="Digit_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="." Click="Decimal_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="=" Click="Equals_Click"/>
        </Grid>
    </Grid>
</Window>